<?xml version="1.0" encoding="utf-8"?>
<!-- Allows HTTP API and WS chat (dev / LAN), matching iOS NSAppTransportSecurity. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
