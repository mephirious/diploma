# Physical iPhone: use Mac Bonjour hostname (scutil --get LocalHostName → <name>.local)
# so USB debugging works even when the phone is not on the same Wi‑Fi subnet.
API_BASE_URL=http://danials-macbook-pro.local:80
CHAT_WS_URL=ws://danials-macbook-pro.local:8070/ws

# iOS Simulator on the same Mac:
# API_BASE_URL=http://127.0.0.1:80
# CHAT_WS_URL=ws://127.0.0.1:8070/ws

# Android Emulator (host machine = 10.0.2.2):
# API_BASE_URL=http://10.0.2.2:80
# CHAT_WS_URL=ws://10.0.2.2:8070/ws

# Physical Android on same Wi‑Fi as the Mac running Docker:
# API_BASE_URL=http://danials-macbook-pro.local:80
# CHAT_WS_URL=ws://danials-macbook-pro.local:8070/ws
